# Local development against a file
DATABASE_URL=sqlite:///./bookies.db
# Deployed: PostgreSQL over the host's unix socket, which docker-compose mounts
# DATABASE_URL=postgresql+psycopg://bookies:PASSWORD@/bookies?host=/var/run/postgresql
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional integrations
# GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# GOOGLE_BOOKS_API_KEY=your_api_key
